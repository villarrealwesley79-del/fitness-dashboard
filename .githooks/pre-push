#!/bin/bash
# Block pushes when the pytest suite is not green.

set -euo pipefail

if [ "${FITNESS_SKIP_PRE_PUSH_TESTS:-0}" = "1" ]; then
    echo "Skipping pre-push pytest suite because FITNESS_SKIP_PRE_PUSH_TESTS=1." >&2
    exit 0
fi

# Git exports GIT_DIR/GIT_INDEX_FILE to hooks; in a linked worktree that breaks
# `git rev-parse --show-toplevel` and any child git invocation (including the
# guard scripts the suite exercises). Resolve everything from PWD instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

# Prefer the repo venv so the suite runs against pinned dependencies; linked
# worktrees have no venv of their own, so fall back to the canonical checkout's
# interpreter before trusting whatever python is on PATH.
if [ -x "${ROOT}/venv/bin/python" ]; then
    PYTHON_BIN="${ROOT}/venv/bin/python"
elif [ -x "/Users/admin/fitness-dashboard/venv/bin/python" ]; then
    PYTHON_BIN="/Users/admin/fitness-dashboard/venv/bin/python"
elif command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    echo "Unable to run pre-push pytest suite: python/python3 not found." >&2
    exit 1
fi

echo "Running pre-push pytest suite: ${PYTHON_BIN} -m pytest -q" >&2
"${PYTHON_BIN}" -m pytest -q
